<div id="run_header">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-xl font-semibold"><%= run.name %></h2>
      <p class="text-xs text-gray-400 font-mono">
        <%= run.run_id %> · <%= run.scene_spec_id %>
        · <span class="font-mono text-xs px-2 py-0.5 rounded inline-flex items-center gap-1 <%= status_color(run.status) %>">
            <%= render "run_steps/spinner" if run.active? %>
            <%= run.status %>
          </span>
      </p>
    </div>
  </div>

  <% stale_count = run.run_steps.where(status: "stale").count %>
  <% gate_open = run.run_steps.where(status: "awaiting_human").exists? %>
  <% blocked = gate_open || run.active? %>
  <% if gate_open %>
    <div class="mt-3 rounded border border-amber-200 bg-amber-50 p-2 text-sm text-amber-800">
      A step is waiting on your decision. Pick an option in the highlighted cell to continue.
    </div>
  <% end %>
  <% if stale_count.positive? %>
    <div class="mt-3 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded p-2 text-sm">
      <%= stale_count %> stale cell<%= "s" if stale_count != 1 %> — re-run them to refresh the dossier before approving.
    </div>
  <% end %>

  <div class="mt-3 flex flex-wrap gap-2">
    <%= button_to "Run next", run_next_run_path(run),
          disabled: blocked,
          class: "bg-gray-900 text-white px-3 py-1.5 rounded text-sm hover:bg-gray-700 disabled:opacity-40 disabled:cursor-not-allowed" %>
    <%= button_to "Run to next decision", run_to_decision_run_path(run),
          disabled: blocked,
          class: "bg-gray-900 text-white px-3 py-1.5 rounded text-sm hover:bg-gray-700 disabled:opacity-40 disabled:cursor-not-allowed" %>
    <% if run.dossier_markdown.present? %>
      <%= button_to "Approve & commit", approve_run_path(run),
            disabled: stale_count.positive? || blocked,
            class: "bg-green-600 text-white px-3 py-1.5 rounded text-sm hover:bg-green-700 disabled:opacity-40 disabled:cursor-not-allowed" %>
      <%= button_to "Abandon", abandon_run_path(run), class: "bg-red-600 text-white px-3 py-1.5 rounded text-sm hover:bg-red-700" %>
    <% end %>
  </div>
</div>
