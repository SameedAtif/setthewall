<% essence = step.output["essence"] || {} %>
<% tally = essence["color_role_tally"] || {} %>
<% roles = Array(essence["image_color_roles"]) %>
<% top = tally.values.max %>
<div class="mt-3 rounded border border-blue-200 bg-blue-50/60 p-3">
  <div class="text-xs font-semibold uppercase tracking-wide text-blue-800">Choose the colour role</div>
  <p class="mt-1 text-xs text-gray-600">
    The reference images split across several roles, so there is no majority. Each role's votes and
    the images that carried it are below — pick the one this style should lead with.
  </p>

  <%= form_with url: color_role_pick_run_step_path(run, step), method: :post, class: "mt-2 space-y-2" do |f| %>
    <% tally.sort_by { |role, count| [-count, role] }.each do |role, count| %>
      <% examples = roles.select { |r| r["color_role"] == role }.map { |r| r["index"] } %>
      <label class="flex cursor-pointer items-start gap-2">
        <%= radio_button_tag "color_role", role, count == top %>
        <span class="text-sm text-gray-800">
          <strong><%= role %></strong> — <%= count %> vote<%= "s" if count != 1 %>
          <% if examples.any? %>
            <span class="text-gray-500">(image<%= "s" if examples.size != 1 %> <%= examples.join(", ") %>)</span>
          <% end %>
        </span>
      </label>
    <% end %>

    <%= f.submit "Use this colour role",
          class: "bg-blue-600 text-white px-3 py-1.5 rounded text-sm hover:bg-blue-700" %>
  <% end %>
</div>
