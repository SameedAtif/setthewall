<%= turbo_frame_tag "step_feedback_#{step.id}" do %>
  <% if local_assigns[:error].present? %>
    <div class="mt-2 text-sm text-red-700 bg-red-50 border border-red-200 rounded p-2"><%= error %></div>
  <% end %>

  <%= form_with url: interpret_run_step_path(run, step), method: :post,
                data: { turbo_frame: "step_feedback_#{step.id}",
                        controller: "cell-feedback",
                        action: "submit->cell-feedback#submit" }, class: "mt-2" do |f| %>
    <%= f.text_area :feedback, rows: 2, placeholder: "Give feedback in plain English…",
          class: "w-full border rounded p-2 text-sm" %>
    <div class="mt-1">
      <%= f.submit "Interpret feedback",
            data: { cell_feedback_target: "submit" },
            class: "bg-blue-600 text-white px-2.5 py-1 rounded text-xs hover:bg-blue-700" %>
    </div>
  <% end %>
<% end %>
