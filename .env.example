ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Qwen (OpenAI-compatible LLM provider)
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# Cap Qwen's thinking so a content prompt can't reason unboundedly (thinking stays ON). 0 = no cap.
QWEN_THINKING_BUDGET=2048

# Image generation — set whichever provider you use (see module 03)
IMAGE_GEN_PROVIDER=manual                        # "manual" | "replicate" | "gemini"
IMAGE_GEN_API_KEY=
REPLICATE_API_KEY=
REPLICATE_MODEL_SLUG=black-forest-labs/flux-1.1-pro
REPLICATE_COST_PER_IMAGE=0.04

# Gemini (Nano Banana) image generation
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_COST_PER_IMAGE=0.04

# C1 — how many of A1's reference images to pass to the image provider per candidate (0 disables)
C1_STYLE_REFERENCE_LIMIT=4

# Etsy (see module 05)
ETSY_ADAPTER=manual                        # switch to "api" when ready
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=
ETSY_OAUTH_TOKEN=

# Web search (module 00b)
TAVILY_API_KEY=
