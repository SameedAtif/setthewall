<% content    = proposal["findings"].is_a?(Hash) ? proposal["findings"] : {} %>
<% findings   = content["findings"].is_a?(Array) ? content["findings"] : [] %>
<% focus      = content["single_recommended_focus"] || content["recommended_style_focus"] %>
<% reasoning  = content["recommendation_reasoning"] %>
<% caveats    = content["methodology_caveats"] %>
<% fragmented = content["breadth_assessment"] == "fragments_into_substyles" %>

<p class="text-sm text-gray-500">
  <%= proposal["search_calls_made"] %> live searches ·
  <%= pluralize(findings.size, "theme") %> identified
  <% if fragmented %><span class="ml-2 text-xs px-2 py-0.5 rounded bg-amber-100 text-amber-800">fragmented — not one coherent style</span><% end %>
</p>

<% if findings.empty? %>
  <p class="text-sm text-gray-500 mt-4">No findings recorded for this step.</p>
<% else %>
  <div class="space-y-3 mt-4">
    <% findings.each do |f| %>
      <div class="border rounded-lg p-4">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-semibold"><%= f["theme"] %></h3>
          <span class="shrink-0 text-xs px-2 py-0.5 rounded <%= f["cross_check_confirmed"] ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600" %>">
            <%= f["cross_check_confirmed"] ? "cross-checked" : "not confirmed" %>
          </span>
        </div>
        <p class="text-sm text-gray-800 mt-1 leading-relaxed"><%= f["demand_to_competition_verdict"] %></p>
        <dl class="mt-2 text-xs text-gray-500 grid grid-cols-2 gap-x-4 gap-y-1">
          <dt>Independent shops</dt><dd><%= f["independent_shops"] %></dd>
          <dt>Competition</dt><dd><%= f["competition_density"] %></dd>
          <dt>Cross-check platform</dt><dd><%= f["cross_check_platform"] %></dd>
        </dl>
      </div>
    <% end %>
  </div>
<% end %>

<% if focus.present? %>
  <h2 class="text-lg font-semibold mt-6">Recommended focus</h2>
  <p class="text-sm text-gray-700 mt-1 leading-relaxed"><%= focus %></p>
  <% if reasoning.present? %>
    <p class="text-sm text-gray-500 mt-1 leading-relaxed"><%= reasoning %></p>
  <% end %>
<% end %>

<% if caveats.present? %>
  <h2 class="text-lg font-semibold mt-6">Methodology caveats</h2>
  <p class="text-sm text-gray-700 mt-1 leading-relaxed"><%= caveats %></p>
<% end %>

<% if proposal["brief"].present? %>
  <details class="mt-6">
    <summary class="text-sm text-blue-600 cursor-pointer">Research brief / methodology</summary>
    <pre class="mt-2 bg-gray-50 border rounded p-3 text-xs overflow-auto whitespace-pre-wrap"><%= proposal["brief"] %></pre>
  </details>
<% end %>
