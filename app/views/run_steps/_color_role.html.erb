<% candidate = step.output["observation_candidate"] %>
<% default_role = step.output["default_override"].presence || "line_only" %>
<div class="mt-3 rounded border border-blue-200 bg-blue-50/60 p-3">
  <div class="text-xs font-semibold uppercase tracking-wide text-blue-800">Choose the color role</div>
  <p class="mt-1 text-xs text-gray-600">
    The scene reads as <strong><%= candidate %></strong>, but this style is
    <strong>minimalist_modern</strong>, whose documented default is
    <strong><%= default_role %></strong>. Confirm the default, or keep
    <%= candidate %> with a catalog-strategy reason.
  </p>

  <%= form_with url: color_role_run_step_path(run, step), method: :post, class: "mt-2 space-y-2" do |f| %>
    <label class="flex cursor-pointer items-start gap-2">
      <%= radio_button_tag "color_role", default_role, true %>
      <span class="text-sm text-gray-800">
        Use the documented default — <strong><%= default_role %></strong>
      </span>
    </label>

    <label class="flex cursor-pointer items-start gap-2">
      <%= radio_button_tag "color_role", candidate %>
      <span class="text-sm text-gray-800">
        Keep <strong><%= candidate %></strong> — reason:
      </span>
    </label>
    <%= text_field_tag "reason", nil, autocomplete: "off",
          placeholder: "catalog-strategy reason (required to keep the observation)",
          class: "w-full rounded border px-2 py-1 text-sm" %>

    <div class="mt-2 space-y-1 border-t border-blue-100 pt-2">
      <label class="flex cursor-pointer items-start gap-2">
        <%= radio_button_tag "color_role", "rewind" %>
        <span class="text-sm text-gray-800">Go back to an earlier step</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2">
        <%= radio_button_tag "color_role", "abandon" %>
        <span class="text-sm text-gray-800">Abandon this run</span>
      </label>
    </div>

    <%= f.submit "Apply decision",
          class: "bg-blue-600 text-white px-3 py-1.5 rounded text-sm hover:bg-blue-700" %>
  <% end %>
</div>
