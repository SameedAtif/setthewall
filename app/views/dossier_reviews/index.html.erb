<div class="max-w-3xl mx-auto p-6">
  <h1 class="text-2xl font-semibold mb-6">Dossier reviews</h1>

  <% if @runs.empty? %>
    <p class="text-gray-500 text-sm">No runs awaiting review.</p>
  <% else %>
    <div class="space-y-2">
      <% @runs.each do |run| %>
        <%= link_to dossier_review_path(run.run_id), class: "block border rounded-lg p-3 hover:bg-gray-50" do %>
          <div class="font-mono text-sm"><%= run.run_id %></div>
          <div class="text-sm text-gray-600"><%= run.style_slug %> / <%= run.scene_spec_id %> · ready <%= time_ago_in_words(run.dossier_ready_at) %> ago</div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
