<% output = step.output || {} %>
<% recommendation = output["recommendation"] || {} %>
<% ranking = Array(recommendation["ranking"]) %>
<% finalists = Array(output["finalists"]) %>
<% candidates = Array(output["candidates"]) %>
<% stage2 = finalists.any? %>
<% items = stage2 ? finalists : candidates %>
<% verdict_class = { "keep" => "text-green-700", "borderline" => "text-amber-700", "drop" => "text-red-700" } %>

<div class="mt-3 rounded border border-blue-200 bg-blue-50/60 p-3">
  <div class="text-xs font-semibold uppercase tracking-wide text-blue-800">
    <%= stage2 ? "Pick the chosen piece" : "Cull to finalists" %>
  </div>

  <% if recommendation["reasoning"].present? %>
    <p class="mt-1 text-sm text-gray-700 whitespace-pre-wrap"><%= recommendation["reasoning"] %></p>
  <% end %>

  <%= form_with url: cull_run_step_path(run, step), method: :post, class: "mt-2 space-y-3" do |f| %>
    <div class="flex flex-wrap gap-3">
      <% items.each do |url| %>
        <% entry = ranking.find { |r| r["url"] == url } %>
        <label class="w-40 cursor-pointer rounded border bg-white p-1">
          <% if stage2 %>
            <%= radio_button_tag "chosen_url", url %>
          <% else %>
            <%= check_box_tag "finalist_urls[]", url %>
          <% end %>
          <%= image_tag reference_image_src(url), class: "mt-1 h-24 w-40 rounded object-cover", loading: "lazy" %>
          <% if entry %>
            <span class="mt-1 block text-[10px] font-semibold uppercase <%= verdict_class[entry['verdict']] %>">
              <%= entry["verdict"] %>
            </span>
            <span class="block text-[10px] leading-tight text-gray-500"><%= entry["reason"] %></span>
            <% if entry["subject"].present? %>
              <span class="mt-0.5 block text-[10px] text-gray-400">subject: <%= entry["subject"] %></span>
            <% end %>
          <% end %>
        </label>
      <% end %>
    </div>

    <% if stage2 %>
      <% finalists.each do |url| %>
        <%= hidden_field_tag "finalist_urls[]", url %>
      <% end %>
    <% end %>

    <%= f.submit stage2 ? "Choose this piece" : "Save finalists & continue",
          class: "bg-blue-600 text-white px-3 py-1.5 rounded text-sm hover:bg-blue-700" %>
  <% end %>
</div>
