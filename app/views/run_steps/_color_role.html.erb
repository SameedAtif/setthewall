<% proposed = step.output["proposed_role"].presence || step.output["observation_candidate"] %>
<% others = RunStepsController::COLOR_ROLES - [proposed] %>
<div class="mt-3 rounded border border-blue-200 bg-blue-50/60 p-3">
  <div class="text-xs font-semibold uppercase tracking-wide text-blue-800">Confirm the color role</div>
  <p class="mt-1 text-xs text-gray-600">
    The run proposes <strong><%= proposed %></strong> for this scene. Confirm it, or choose a
    different role with a catalog-strategy reason.
    <% if Array(step.output["conflicts"]).any? %>
      <span class="text-yellow-700">Cross-check conflicts: <%= Array(step.output["conflicts"]).join("; ") %>.</span>
    <% end %>
  </p>

  <%= form_with url: color_role_run_step_path(run, step), method: :post, class: "mt-2 space-y-2" do |f| %>
    <label class="flex cursor-pointer items-start gap-2">
      <%= radio_button_tag "color_role", proposed, true %>
      <span class="text-sm text-gray-800">Confirm <strong><%= proposed %></strong></span>
    </label>

    <% others.each do |role| %>
      <label class="flex cursor-pointer items-start gap-2">
        <%= radio_button_tag "color_role", role %>
        <span class="text-sm text-gray-800">Use <strong><%= role %></strong></span>
      </label>
    <% end %>

    <%= text_field_tag "reason", nil, autocomplete: "off",
          placeholder: "catalog-strategy reason (required only if you change the proposed role)",
          class: "w-full rounded border px-2 py-1 text-sm" %>

    <div class="mt-2 space-y-1 border-t border-blue-100 pt-2">
      <label class="flex cursor-pointer items-start gap-2">
        <%= radio_button_tag "color_role", "rewind" %>
        <span class="text-sm text-gray-800">Go back to an earlier step</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2">
        <%= radio_button_tag "color_role", "abandon" %>
        <span class="text-sm text-gray-800">Abandon this run</span>
      </label>
    </div>

    <%= f.submit "Apply decision",
          class: "bg-blue-600 text-white px-3 py-1.5 rounded text-sm hover:bg-blue-700" %>
  <% end %>
</div>
